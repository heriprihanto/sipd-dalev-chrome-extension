POSTGRES_DB=db_sipd_dalev
POSTGRES_PORT=5432
POSTGRES_USER=monevrkpd
POSTGRES_PASSWORD=heriprihanto140286
POSTGRES_SCHEMA=public
TABLE_PROGRAM=dalev_realisasi_program
TABLE_SUBKEGIATAN=dalev_realisasi_subkegiatan
# Tahap & tanggal tarik data (bagian `jobs_info` pada respons SIPD).
TABLE_META=dalev_jobs_info
# Riwayat eksekusi tombol Download di extension.
TABLE_JOBS=dalev_download_jobs

TAHUN_ANGGARAN=2026
KODE_PEMDA=3376

# Kosongkan API_KEY untuk mematikan autentikasi (mis. saat pengembangan lokal).
API_KEY=
API_HOST=0.0.0.0
API_PORT=8000
# Origin yang diizinkan memanggil API (dipisah koma). Halaman SIPD dibutuhkan
# supaya content script bisa memanggil API langsung; permintaan dari service
# worker extension tidak terkena CORS.
CORS_ORIGINS=https://sipd.kemendagri.go.id
# Buat schema + tabel (dan kolom baru) otomatis saat aplikasi start.
CREATE_TABLES=true
DB_ECHO=false
# Simpan juga baris JSON asli ke kolom `raw`; membesarkan ukuran tabel.
STORE_RAW=false
